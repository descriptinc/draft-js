{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "emitDeclarationOnly": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "lib",
    "src/**/__tests__/**/*",
    "src/**/__mocks__/**/*",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
